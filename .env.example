POSTGRES_DB=partyplaner
POSTGRES_USER=partyplaner
POSTGRES_PASSWORD=change-me

# Signs the access tokens. At least 32 characters:  openssl rand -base64 48
JWT_SECRET=

# true whenever the site is served over HTTPS (it must be, outside local development).
# Set to false only for plain-http local testing.
COOKIE_SECURE=false

# Set to false to stop new sign-ups once your own account exists.
REGISTRATION_ENABLED=true

# Optional
# FRONTEND_PORT=3000        # host port of the web app
# POSTGRES_PORT=5432        # host port (127.0.0.1 only) of the database
# REGISTRY=ghcr.io/samuelthomas08   # where `docker compose pull` fetches the images from
# IMAGE_TAG=latest
